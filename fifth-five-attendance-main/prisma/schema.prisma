// Prisma schema for IUB BS IT - 5th-5M Attendance Portal
// Free-tier Postgres (Neon / Supabase) works fine with this schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN   // Class Representative
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

// One login account per person (CR or Student). Students are linked 1:1 to a Student profile.
model User {
  id           String   @id @default(cuid())
  role         Role
  email        String?  @unique // used by ADMIN login
  loginId      String?  @unique // IUB ID / Registration Number, used by STUDENT login
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student   Student? @relation(fields: [studentId], references: [id])
  studentId String?  @unique

  auditLogs AuditLog[]

  @@index([role])
}

model Student {
  id           String   @id @default(cuid())
  fullName     String
  iubId        String   @unique // e.g. BSIT-F21-045
  regNumber    String   @unique
  semester     String
  program      String   @default("BS Information Technology")
  section      String   @default("5TH-5M")
  email        String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user               User?
  attendanceRecords  AttendanceRecord[]
  pollVotes          PollVote[]
