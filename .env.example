# Add these in Vercel: Project -> Settings -> Environment Variables
# Neon connection string (use the "pooled" one, it contains -pooler in the host)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# First-run CR account (created automatically the first time the site is opened)
ADMIN_USERNAME=cr
ADMIN_PASSWORD=change-this-now
# Students must enter this code to sign up
CLASS_CODE=change-this-code
# Optional: fixed secret for login cookies (if empty, one is derived from DATABASE_URL)
# JWT_SECRET=
