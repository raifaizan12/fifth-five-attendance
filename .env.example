# Copy to .env (or set these in your host's dashboard)
PORT=3000
# Where the SQLite database lives. Put this on a persistent disk/volume.
DATA_DIR=./data
# First-run CR account (only used when no CR exists yet)
ADMIN_USERNAME=cr
ADMIN_PASSWORD=change-this-now
# Students must enter this code to sign up. Share it with your class.
CLASS_CODE=change-this-code
# Optional: fixed signing key for login cookies (otherwise one is generated in DATA_DIR)
# JWT_SECRET=
