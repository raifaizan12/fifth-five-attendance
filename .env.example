# PostgreSQL connection string.
# Free option: create a free project at https://neon.tech (or https://supabase.com)
# and paste the connection string it gives you here.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Generate a random secret: run `openssl rand -base64 32` in a terminal
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# The public URL of your deployed app (Vercel gives you this after first deploy)
NEXTAUTH_URL="http://localhost:3000"

# Initial CR/Admin account, used by the seed script
SEED_ADMIN_EMAIL="cr@fifthfive.iub.edu.pk"
SEED_ADMIN_PASSWORD="ChangeThisPassword123!"
